{%- set classes = html_classes(
    'bg-info size-3 mt-[6px] rounded-full shadow-[0px_0px_0px_4px_var(--info-soft)]',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<div
    data-slot="timeline-dot"
    class="{{ classes|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
