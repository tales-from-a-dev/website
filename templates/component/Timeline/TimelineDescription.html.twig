{%- set classes = html_classes(
    'text-info text-sm font-semibold',
    attributes.render('class')|default(''),
) -%}

{%- set element = attributes.has('href') ? 'a' : 'p' -%}

{#- Template -#}

<{{ element }}
    data-slot="timeline-description"
    class="{{ classes|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</{{ element }}>
