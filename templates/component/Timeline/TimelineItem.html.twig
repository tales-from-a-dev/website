{%- set classes = html_classes(
    'group/timeline-item grid grid-cols-[16px_1fr] gap-6',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<div
    data-slot="timeline-item"
    class="{{ classes|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
