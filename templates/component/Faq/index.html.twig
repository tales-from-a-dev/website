{%- set classes = html_classes(
    'group/faq border-b last:border-b-0',
    'details-content:grid details-content:grid-rows-[0fr] details-content:duration-200 details-content:ease-out',
    'details-content:transition-[grid-template-rows,content-visibility] details-content:transition-discrete',
    'open:details-content:grid-rows-[1fr]',
    'motion-reduce:details-content:transition-none',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<details
    data-slot="faq"
    class="{{ classes|tailwind_classes }}"
    {{ attributes.defaults({name: 'faq'}) }}
>
    {% block content %}{% endblock %}
</details>
