{%- props variant = 'yellow' -%}

{%- set ctx = html_cva(
    base: 'relative inline-block leading-none font-mono font-semibold z-10 before:absolute before:-z-10 before:-inset-1 before:-skew-y-2 before:rounded-sm',
    variants: {
        variant: {
            yellow: 'before:bg-golden-orange text-white',
            purple: 'before:bg-[#4f5b93] text-white',
            black: 'before:bg-primary text-primary-foreground',
            red: 'before:bg-oxidized-iron text-primary-foreground',
        },
    },
) -%}

{#- Template -#}

<mark
    data-slot="text-highlight"
    class="{{ ctx.apply({variant: variant}, attributes.render('class'))|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content -%}{%- endblock -%}
</mark>
