{%- props variant = 'default', -%}

{%- set style = html_cva(
    base: 'group/post flex flex-col has-data-[slot=post-footer]:pb-0 has-[>img:first-child]:pt-0 *:[img:first-child]:rounded-t-md *:[img:last-child]:rounded-b-md',
    variants: {
        variant: {
            default: 'gap-8',
            card: 'bg-card text-card-foreground overflow-hidden gap-3.5 py-6 rounded-md ring-1 ring-foreground/10 h-full shadow-sm transition-transform duration-200 hover:-translate-y-1',
        },
    },
) -%}

{%- set classes = html_classes(
    'group/post',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<article
    data-slot="post"
    data-variant="{{ variant }}"
    class="{{ style.apply({variant: variant}, attributes.render('class'))|tailwind_classes }}"
    {{ attributes }}
>
    {% block content %}{% endblock %}
</article>
