{%- props post, heading = 'h2' -%}

{#- Template -#}

<twig:Post variant="card">
    <twig:Post:PostHeader>
        <twig:Post:PostMeta>
            <twig:Post:PostCategory :category="post.category"/>
            <time
                class="text-muted-foreground text-xs font-mono flex items-center gap-1"
                datetime="{{ post.publishedAt|date('Y-m-d') }}"
            >
                <twig:Ux:Icon name="lucide:calendar" class="size-3"/>
                {{- post.publishedAt|format_date(pattern: 'd MMMM Y') -}}
            </time>
            <span class="text-muted-foreground" aria-hidden="true">&middot;</span>
            <span data-slot="reading-time" class="text-muted-foreground text-xs font-mono">
                {{- 'website.blog.reading_time'|trans({minutes: post.readingTime}) -}}
            </span>
        </twig:Post:PostMeta>
        <twig:Post:PostTitle as="{{ heading }}">
            <a href="{{ path('app_website_blog_show', {slug: post.slug}) }}" class="hover:underline">
                {{- post.title -}}
            </a>
        </twig:Post:PostTitle>
    </twig:Post:PostHeader>
    {% if post.description is not empty %}
        <twig:Post:PostContent>
            {{ post.description }}
        </twig:Post:PostContent>
    {% endif %}
    <twig:Post:PostFooter class="justify-between">
        {% if post.tags is not empty %}
            <div class="flex flex-wrap gap-2">
                {% for tag in post.tags %}
                    <twig:Badge variant="secondary" href="{{ path('app_website_blog_tag', {tag: tag}) }}">
                        {{- tag -}}
                    </twig:Badge>
                {% endfor %}
            </div>
        {% endif %}
        <twig:Button
            variant="link"
            size="sm"
            class="px-0 text-dark-cyan font-semibold"
            href="{{ path('app_website_blog_show', {slug: post.slug}) }}"
        >
            {{ 'website.index.section.blog.read_more'|trans }}
            <twig:Ux:Icon name="lucide:arrow-right"/>
        </twig:Button>
    </twig:Post:PostFooter>
</twig:Post>
