{%- props as = 'h2' -%}

{%- set classes = html_classes(
    'text-2xl font-extrabold md:text-4xl',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<{{ as }}
    data-slot="section-title"
    class="{{ classes|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
