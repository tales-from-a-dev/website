{%- set classes = html_classes(
    'flex flex-col items-start gap-1 md:grid md:auto-rows-min pb-10',
    'md:has-data-[slot=section-action]:grid-cols-[1fr_auto] md:has-data-[slot=section-description]:grid-rows-[auto_auto]',
    attributes.render('class')|default(''),
) -%}

{#- Template -#}

<div
    data-slot="section-header"
    class="{{ classes|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
