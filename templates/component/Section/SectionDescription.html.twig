{%- props variant = 'default' -%}

{%- set style = html_cva(
    base: 'text-base/6',
    variants: {
        variant: {
            default: 'text-muted-foreground',
            primary: 'text-primary',
            secondary: 'font-mono text-info',
            surtitle: 'font-mono font-semibold text-info text-sm uppercase',
        },
    },
) -%}

{#- Template -#}

<p
    data-slot="section-description"
    data-variant="{{ variant }}"
    class="{{ style.apply({variant: variant}, attributes.render('class'))|tailwind_classes }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</p>
