{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ 'website.resume.title'|trans }} | {{ parent() }}{% endblock %}

{% block main %}
    <twig:Section id="resume">
        <twig:Button
            variant="muted"
            class="px-0 mb-8 font-semibold print:hidden"
            href="{{ path('app_website_shared_index') }}"
        >
            <twig:Ux:Icon name="lucide:arrow-left"/>
            {{ 'common.cta.back_to_home'|trans }}
        </twig:Button>
        <twig:Section:SectionHeader>
            <twig:Section:SectionTitle as="h1"
                                       class="text-3xl font-extrabold">{{ 'app.author'|trans }}</twig:Section:SectionTitle>
            <twig:Section:SectionDescription
                variant="secondary">{{ 'app.job_title'|trans }}</twig:Section:SectionDescription>
            <twig:Section:SectionAction class="print:hidden">
                <twig:Button
                    variant="ternary"
                    size="lg"
                    title="{{ 'website.resume.action.print'|trans }}"
                    onclick="window.print()"
                >
                    <twig:Ux:Icon name="lucide:printer"/>
                </twig:Button>
            </twig:Section:SectionAction>
        </twig:Section:SectionHeader>
        <twig:Section:SectionContent class="grid grid-cols-[2fr_4fr] gap-8 print:grid-cols-[2fr_5fr] print:gap-4">
            <div class="flex flex-col gap-8">
                {# Contact #}
                <div>
                    <twig:Card size="sm">
                        <twig:Card:CardContent class="flex flex-col items-start *:px-0 *:justify-start">
                            <span class="h-7 inline-flex items-center gap-1 text-[0.8rem] text-primary font-medium">
                                <twig:Ux:Icon name="lucide:map-pin" class="size-3.5"/>
                                {{ 'website.resume.contact.location'|trans }}
                            </span>
                            <twig:Button
                                variant="link"
                                size="sm"
                                href="mailto:monteil.romain@gmail.com"
                            >
                                <twig:Ux:Icon name="lucide:mail"/>
                                monteil.romain@gmail.com
                            </twig:Button>
                            <twig:Button
                                variant="link"
                                size="sm"
                                href="https://talesfroma.dev"
                                target="_blank"
                            >
                                <twig:Ux:Icon name="lucide:globe"/>
                                talesfroma.dev
                            </twig:Button>
                            <twig:Button
                                variant="link"
                                size="sm"
                                href="https://github.com/ker0x"
                                target="_blank"
                            >
                                <twig:Ux:Icon name="simple-icons:github"/>
                                github.com/ker0x
                            </twig:Button>
                            <twig:Button
                                variant="link"
                                size="sm"
                                href="https://www.linkedin.com/in/romain-monteil/"
                                target="_blank"
                            >
                                <twig:Ux:Icon name="simple-icons:linkedin"/>
                                linkedin.com/in/romain-monteil/
                            </twig:Button>
                            <twig:Button
                                variant="link"
                                size="sm"
                                href="https://connect.symfony.com/profile/ker0x"
                                target="_blank"
                            >
                                <twig:Ux:Icon name="simple-icons:symfony"/>
                                connect.symfony.com/profile/ker0x
                            </twig:Button>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
                {# Skills #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.skills.title'|trans }}</h2>
                    {% for key, skill in skills %}
                        <twig:Card size="sm">
                            <twig:Card:CardHeader>
                                <twig:Card:CardTitle>{{ ('website.resume.section.skills.' ~ key ~ '.title')|trans }}</twig:Card:CardTitle>
                            </twig:Card:CardHeader>
                            <twig:Card:CardContent class="flex flex-wrap gap-1.5 print:gap-1">
                                {% for item in skill %}
                                    <twig:Badge variant="secondary" class="h-5">{{ item }}</twig:Badge>
                                {% endfor %}
                            </twig:Card:CardContent>
                        </twig:Card>
                    {% endfor %}
                </div>
                {# Certifications #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.certifications.title'|trans }}</h2>
                    <twig:Card size="sm">
                        <twig:Card:CardContent>
                            <div class="flex flex-col gap-2">
                                {% for certification in certifications %}
                                    <span class="text-sm text-primary font-medium">{{ certification.name }}</span>
                                {% endfor %}
                            </div>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
                {# Languages #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.languages.title'|trans }}</h2>
                    <twig:Card size="sm">
                        <twig:Card:CardContent>
                            <dl class="grid grid-cols-[1fr_4fr] gap-2">
                                {% for language in languages %}
                                    <dt class="text-sm text-primary font-medium capitalize">{{ language.code|language_name }}</dt>
                                    <dd class="text-sm text-muted-foreground text-sm">{{ ('enum.language_level.' ~ language.level)|trans }}</dd>
                                {% endfor %}
                            </dl>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
                {# Other #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.other.title'|trans }}</h2>
                    <twig:Card size="sm">
                        <twig:Card:CardContent>
                            <div class="flex flex-col gap-2">
                                {% for item in other %}
                                    <span class="text-sm text-primary font-medium">{{ ('website.resume.section.other.item.' ~ item)|trans }}</span>
                                {% endfor %}
                            </div>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
            </div>
            <div>
                {# Work Experience #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.experience.title'|trans }}</h2>
                    <twig:Card size="sm">
                        <twig:Card:CardContent>
                            <twig:Timeline>
                                {% for experience in experiences %}
                                    {% set is_last = loop.last %}
                                    <twig:Timeline:TimelineItem>
                                        <twig:Timeline:TimelineConnector>
                                            <twig:Timeline:TimelineDot/>
                                            {% if not is_last %}
                                                <twig:Timeline:TimelineSeparator/>
                                            {% endif %}
                                        </twig:Timeline:TimelineConnector>
                                        <twig:Timeline:TimelineContent>
                                            <twig:Timeline:TimelineHeader>
                                                <twig:Timeline:TimelineTitle>{{ experience.position|trans }}</twig:Timeline:TimelineTitle>
                                                <twig:Timeline:TimelineDate>
                                                    {{ experience.startAt|format_date(pattern: 'MMM Y') }}
                                                    - {{ experience.endAt ? experience.endAt|format_date(pattern: 'MMM Y') : 'website.index.section.experience.today'|trans }}
                                                </twig:Timeline:TimelineDate>
                                            </twig:Timeline:TimelineHeader>
                                            {% if experience.website %}
                                                <twig:Timeline:TimelineDescription
                                                    class="pt-1 pb-3 block underline underline-offset-4"
                                                    href="{{ experience.website }}"
                                                    target="_blank"
                                                >
                                                    {{ experience.company }}
                                                </twig:Timeline:TimelineDescription>
                                            {% else %}
                                                <twig:Timeline:TimelineDescription
                                                    class="pt-1 pb-3">{{ experience.company }}</twig:Timeline:TimelineDescription>
                                            {% endif %}
                                            {% if experience.description is not empty %}
                                                <div class="pb-3 text-muted-foreground print:pb-1">
                                                    {{ experience.description|markdown_to_html }}
                                                </div>
                                            {% endif %}
                                            {% if experience.technologies is not empty %}
                                                <div class="flex flex-wrap gap-2 print:gap-1">
                                                    {% for technology in experience.technologies %}
                                                        <twig:Badge variant="outline">{{ technology }}</twig:Badge>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </twig:Timeline:TimelineContent>
                                    </twig:Timeline:TimelineItem>
                                {% endfor %}
                            </twig:Timeline>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
                {# Educations #}
                <div>
                    <h2 class="text-dark-cyan font-bold uppercase">{{ 'website.resume.section.education.title'|trans }}</h2>
                    <twig:Card size="sm">
                        <twig:Card:CardContent>
                            <twig:Timeline>
                                {% for education in educations %}
                                    {% set is_last = loop.last %}
                                    <twig:Timeline:TimelineItem>
                                        <twig:Timeline:TimelineConnector>
                                            <twig:Timeline:TimelineDot/>
                                            {% if not is_last %}
                                                <twig:Timeline:TimelineSeparator/>
                                            {% endif %}
                                        </twig:Timeline:TimelineConnector>
                                        <twig:Timeline:TimelineContent>
                                            <twig:Timeline:TimelineHeader>
                                                <twig:Timeline:TimelineTitle>{{ education.title }}</twig:Timeline:TimelineTitle>
                                                <twig:Timeline:TimelineDate>{{ "#{education.startAt} - #{education.endAt}" }}</twig:Timeline:TimelineDate>
                                            </twig:Timeline:TimelineHeader>
                                            <div class="pb-3 text-muted-foreground print:pb-1">
                                                {{ "#{education.school}, #{education.place}" }}
                                            </div>
                                        </twig:Timeline:TimelineContent>
                                    </twig:Timeline:TimelineItem>
                                {% endfor %}
                            </twig:Timeline>
                        </twig:Card:CardContent>
                    </twig:Card>
                </div>
            </div>
        </twig:Section:SectionContent>
    </twig:Section>
{% endblock %}
