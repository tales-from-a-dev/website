{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ 'website.blog.tag.title'|trans({tag: tag}) }} | {{ parent() }}{% endblock %}

{% block meta_description %}{{ 'website.blog.meta.description'|trans }}{% endblock %}

{% block meta_robots %}noindex, follow{% endblock %}

{% block main %}
    <twig:Section id="blog-tag">
        <twig:Button
            variant="muted"
            class="px-0 mb-8 font-semibold"
            href="{{ path('app_website_blog_index') }}"
        >
            <twig:Ux:Icon name="lucide:arrow-left" />
            {{ 'website.blog.back_to_index'|trans }}
        </twig:Button>
        <twig:Section:SectionHeader>
            {%- set tag_badge -%}
                <twig:Badge variant="ternary" class="align-middle px-2.5 py-1 text-base">{{ tag }}</twig:Badge>
            {%- endset -%}

            <twig:Section:SectionDescription variant="surtitle">{{ 'website.index.section.blog.surtitle'|trans }}</twig:Section:SectionDescription>
            <twig:Section:SectionTitle as="h1">{{- 'website.blog.tag.title'|trans({tag: tag_badge})|raw -}}</twig:Section:SectionTitle>
        </twig:Section:SectionHeader>
        <twig:Section:SectionContent class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for post in posts %}
                <twig:Blog:PostCard :post="post" />
            {% endfor %}
        </twig:Section:SectionContent>
    </twig:Section>
{% endblock %}
