{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ 'website.blog.title'|trans }} | {{ parent() }}{% endblock %}

{% block meta_description %}{{ 'website.blog.meta.description'|trans }}{% endblock %}

{% block main %}
    <twig:Section id="blog">
        <twig:Button
            variant="muted"
            class="px-0 mb-8 font-semibold"
            href="{{ path('app_website_shared_index') }}"
        >
            <twig:Ux:Icon name="lucide:arrow-left" />
            {{ 'common.cta.back_to_home'|trans }}
        </twig:Button>
        <twig:Section:SectionHeader>
            <twig:Section:SectionDescription variant="surtitle">{{ 'website.index.section.blog.surtitle'|trans }}</twig:Section:SectionDescription>
            <twig:Section:SectionTitle as="h1">{{ 'website.blog.title'|trans }}</twig:Section:SectionTitle>
            <twig:Section:SectionDescription>{{ 'website.blog.subtitle'|trans }}</twig:Section:SectionDescription>
        </twig:Section:SectionHeader>
        <twig:Section:SectionContent class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% if posts is empty %}
                <p class="text-muted-foreground">{{ 'website.blog.empty'|trans }}</p>
            {% else %}
                {% for post in posts %}
                    <twig:Blog:PostCard :post="post" />
                {% endfor %}
            {% endif %}
        </twig:Section:SectionContent>
    </twig:Section>
{% endblock %}
