{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ post.title }} | {{ parent() }}{% endblock %}

{% block meta_description %}{{ post.description|default('app.meta.description'|trans) }}{% endblock %}

{% block meta_og_image %}
    {% if post.cover %}
        <meta property="og:image" content="{{ absolute_url(asset(post.cover)) }}">
    {% endif %}
{% endblock %}

{#- The base block merges _locale into the current route parameters, which keeps the
    English slug on the French URL; posts resolve theirs through translation_key. -#}
{% block meta_hreflang %}
    {% for locale, href in alternates %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ href }}" />
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ alternates[default_locale]|default(alternates[app.locale]) }}" />
{% endblock %}

{% block meta_jsonld %}
    {{ structured_data|serialize('jsonld')|raw }}
{% endblock %}

{% block main %}
    <main class="container max-w-screen-md mx-auto px-4 md:px-8 py-16 md:py-24">
        <article>
            <header class="flex flex-col gap-4 mb-10">
                <h1 class="font-medium text-3xl md:text-4xl">{{ post.title }}</h1>
                <div class="flex flex-wrap items-center gap-3 text-muted-foreground">
                    <twig:Badge href="{{ path('app_website_blog_category', {category: post.category.value}) }}">
                        {{- post.category|trans -}}
                    </twig:Badge>
                    <time datetime="{{ post.publishedAt|date('Y-m-d') }}">
                        {{- 'website.blog.published_at'|trans({date: post.publishedAt|format_date(pattern: 'd MMMM Y')}) -}}
                    </time>
                </div>
                {% if post.tags is not empty %}
                    <nav data-slot="blog-tags" aria-label="{{ 'website.blog.tags.title'|trans }}" class="flex flex-wrap gap-2">
                        {% for tag in post.tags %}
                            <twig:Badge variant="secondary" href="{{ path('app_website_blog_tag', {tag: tag}) }}">
                                {{- tag -}}
                            </twig:Badge>
                        {% endfor %}
                    </nav>
                {% endif %}
            </header>
            <div data-slot="post-content" class="prose max-w-none prose-headings:font-medium prose-a:underline-offset-4">
                {{ content|raw }}
            </div>
        </article>
        <footer class="mt-16">
            <twig:Button variant="link" href="{{ path('app_website_blog_index') }}">
                <twig:Ux:Icon name="lucide:arrow-left" />
                {{ 'website.blog.back_to_index'|trans }}
            </twig:Button>
        </footer>
    </main>
{% endblock %}
