{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ post.title }} | {{ parent() }}{% endblock %}

{% block meta_description %}{{ post.description|default('app.meta.description'|trans) }}{% endblock %}

{% block meta_og_image %}
    {% if post.cover %}
        <meta property="og:image" content="{{ absolute_url(asset(post.cover)) }}">
    {% endif %}
{% endblock %}

{#- The base block merges _locale into the current route parameters, which keeps the
    English slug on the French URL; posts resolve theirs through translation_key. -#}
{% block meta_hreflang %}
    {% for locale, href in alternates %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ href }}"/>
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ alternates[default_locale]|default(alternates[app.locale]) }}"/>
{% endblock %}

{% block meta_jsonld %}
    {{ structured_data|serialize('jsonld')|raw }}
{% endblock %}

{% block main %}
    <twig:Section id="blog">
        <twig:Button
            variant="muted"
            class="px-0 mb-8 font-semibold"
            href="{{ path('app_website_blog_index') }}"
        >
            <twig:Ux:Icon name="lucide:arrow-left"/>
            {{ 'website.blog.back_to_index'|trans }}
        </twig:Button>
        <twig:Section:SectionContent>
            <twig:Post>
                <twig:Post:PostHeader>
                    <twig:Post:PostMeta>
                        <twig:Post:PostCategory :category="post.category"/>
                        <time class="text-muted-foreground text-xs font-mono flex items-center gap-1" datetime="{{ post.publishedAt|date('Y-m-d') }}">
                            <twig:Ux:Icon name="lucide:calendar" class="size-3"/>
                            {{- post.publishedAt|format_date(pattern: 'd MMMM Y') -}}
                        </time>
                        <span class="text-muted-foreground" aria-hidden="true">&middot;</span>
                        <span data-slot="reading-time" class="text-muted-foreground text-xs font-mono">
                                {{- 'website.blog.reading_time'|trans({minutes: post.readingTime}) -}}
                            </span>
                    </twig:Post:PostMeta>
                    <twig:Post:PostTitle>{{ post.title }}</twig:Post:PostTitle>
                </twig:Post:PostHeader>
                {% for locale, href in alternates|filter((href, locale) => locale != app.locale) %}
                    <twig:Alert
                        variant="info"
                        role="note"
                        data-role="post-translation"
                        lang="{{ locale }}"
                    >
                        <twig:Ux:Icon name="lucide:languages"/>
                        <twig:Alert:AlertTitle>
                            {{- 'website.blog.translation.notice'|trans({
                                language: '<a href="%s" hreflang="%s">%s</a>'|format(
                                    href|e,
                                    locale,
                                    'website.blog.translation.language'|trans({}, 'messages', locale)|e,
                                ),
                            }, 'messages', locale)|raw -}}
                        </twig:Alert:AlertTitle>
                    </twig:Alert>
                {% endfor %}
                <twig:Post:PostContent>
                    {{ content|raw }}
                </twig:Post:PostContent>
                <twig:Post:PostFooter>
                    {% if post.tags is not empty %}
                        <nav data-slot="blog-tags" aria-label="{{ 'website.blog.tags.title'|trans }}"
                             class="flex flex-wrap gap-2">
                            {% for tag in post.tags %}
                                <twig:Badge variant="secondary"
                                            href="{{ path('app_website_blog_tag', {tag: tag}) }}">
                                    {{- tag -}}
                                </twig:Badge>
                            {% endfor %}
                        </nav>
                    {% endif %}
                </twig:Post:PostFooter>
            </twig:Post>
        </twig:Section:SectionContent>
    </twig:Section>
{% endblock %}
