{% extends 'app/base_website.html.twig' %}

{% block meta_title %}{{ 'website.blog.category.title'|trans({category: category|trans}) }} | {{ parent() }}{% endblock %}

{% block meta_description %}{{ 'website.blog.category.meta.description'|trans({category: category|trans}) }}{% endblock %}

{% block meta_hreflang %}
    {% for locale, href in alternates %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ href }}"/>
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ alternates[default_locale]|default(alternates[app.locale]) }}"/>
{% endblock %}

{% block main %}
    <twig:Section id="blog-tag">
        <twig:Button
            variant="muted"
            class="px-0 mb-8 font-semibold"
            href="{{ path('app_website_blog_index') }}"
        >
            <twig:Ux:Icon name="lucide:arrow-left"/>
            {{ 'website.blog.back_to_index'|trans }}
        </twig:Button>
        <twig:Section:SectionHeader>
            {%- set category_badge -%}
                <twig:Post:PostCategory :category="category" class="align-middle text-base"/>
            {%- endset -%}

            <twig:Section:SectionDescription variant="surtitle">
                {{- 'website.index.section.blog.surtitle'|trans -}}
            </twig:Section:SectionDescription>
            <twig:Section:SectionTitle as="h1">
                {{- 'website.blog.category.title'|trans({category: category_badge})|raw -}}
            </twig:Section:SectionTitle>
        </twig:Section:SectionHeader>
        <twig:Section:SectionContent class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for post in posts %}
                <twig:Blog:PostCard :post="post"/>
            {% endfor %}
        </twig:Section:SectionContent>
    </twig:Section>
{% endblock %}
